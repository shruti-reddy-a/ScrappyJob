{
  "version": 2,
  "builds": [
    {
      "src": "pubspec.yaml",
      "use": "@now/static-build",
      "config": {
        "distDir": "build/web",
        "buildCommand": "flutter build web --release"
      }
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
