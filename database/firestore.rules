rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    match /jobs/{jobId} {
      // User can read/write their own jobs.
      // On create, ensure the user_id being written matches the auth.uid
      // On read/update/delete, ensure the existing document's user_id matches the auth.uid
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
    }
    
    // User can only read their own job runs (backend creates them)
    match /job_runs/{runId} {
      allow read: if request.auth != null && resource.data.user_id == request.auth.uid;
      // Allow backend to create using Firebase Admin SDK (which bypasses these rules)
      allow write: if false; 
    }
    
    // User can read and send STOP commands to run_progress
    match /run_progress/{jobId} {
      allow read, write: if request.auth != null;
    }

    // User can read/write their own ATS platforms
    match /ats_platforms/{platformId} {
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
    }
    // User can read/write their own settings
    match /user_settings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
